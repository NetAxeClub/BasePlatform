Value Required,Filldown AGGNAME (\S+)
Value Filldown MODE (\w+)
Value Required,List MEMBERPORTS (\S+(?:\(R\))?)
Value List STATUS (S|U|I)


Start
  ^No\s+link\s+aggregation\s+group\s+exists. -> EOF
  ^Aggregate\s+Interface:\s+${AGGNAME} -> AGG
  ^Aggregation\s+Interface:\s+${AGGNAME} -> AGG

AGG
  ^Aggregate\s+Interface:\s+${AGGNAME} -> Record Start
  ^Aggregation\s+Interface:\s+${AGGNAME} -> Record Start
  ^Aggregation\s+Mode:\s+${MODE}
  ^Local:\s* -> LOCAL
  ^$$

LOCAL
  ^Remote:\s* -> Record REMOTE
  ^Aggregate\s+Interface:\s+${AGGNAME} -> Record Start
  ^Aggregation\s+Interface:\s+${AGGNAME} -> Record Start
  ^\s+${MEMBERPORTS}\s+${STATUS}\s+\d+\s+\d+\s+\d+\s+\{[A-Z]+\}
  ^\s+${MEMBERPORTS}\s+${STATUS}\s+\d+\s+\d+\s+\{[A-Z]+\}

REMOTE
  ^Aggregate\s+Interface:\s+${AGGNAME} -> AGG
  ^Aggregation\s+Interface:\s+${AGGNAME} -> AGG
  ^$$
