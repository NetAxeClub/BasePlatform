Value TRUNK_NUM (\S+)
Value List PortName (\S+)
Value List PortStatus (Down|Up|Selected)
Value List PortWeight (\d+)
Value LAGID (\d+)
Value MODE (\S+)


Start
  ^${TRUNK_NUM}'s state information is:\s*
  ^Local:\s* -> LOCAL
  ^PortName\s+Status\s+Weight\s* -> PortList

PortList
  ^${PortName}\s+${PortStatus}\s+${PortWeight}
  ^\s* -> Record Start

LOCAL
  ^LAG\sID:\s*${LAGID}\s+Working\sMode:\s${MODE}
  ^Preempt\sDelay
  ^System\sPriority:
  ^Least\sActive-linknumber
  ^Operating\sStatus
  ^Timeout\sPeriod
  ^PortKeyMode
  ^-+
  ^ActorPortName
  ^${PortName}\(\w+\)\s+${PortStatus}\s+
  ^${PortName}\s+${PortStatus}\s+
  # ^\S+'s state information is:\s* -> Start
  ^$$ -> Record Start

